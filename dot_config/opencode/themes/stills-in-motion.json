{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0a0703",
    "bgLighter": "#23201c",
    "bgDark": "#080502",
    "bgDarker": "#050402",
    "fg": "#DBD0BC",
    "fgLight": "#e0d7c6",
    "fgBright": "#e4dccd",
    "fgDark": "#a49c8d",
    "muted": "#605e58",
    "olive": "#7e8468",
    "oliveBright": "#939978",
    "red": "#a2947d",
    "redBright": "#bba98d",
    "orange": "#b0a491",
    "yellow": "#fef2cb",
    "yellowBright": "#fff1c1",
    "green": "#cbc3a3",
    "greenBright": "#e4dab0",
    "tan": "#c0a78c",
    "tanBright": "#dcbc99",
    "pale": "#dfddb2",
    "paleBright": "#f7f5c0",
    "white": "#f9f5ea"
  },
  "theme": {
    "primary": { "dark": "pale", "light": "olive" },
    "secondary": { "dark": "olive", "light": "olive" },
    "accent": { "dark": "olive", "light": "olive" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "pale", "light": "olive" },
    "text": { "dark": "fg", "light": "bg" },
    "textMuted": { "dark": "muted", "light": "bgLighter" },
    "background": { "dark": "bg", "light": "fgLight" },
    "backgroundPanel": { "dark": "bgLighter", "light": "fgLight" },
    "backgroundElement": { "dark": "bgDark", "light": "fgLight" },
    "border": { "dark": "bgLighter", "light": "muted" },
    "borderActive": { "dark": "muted", "light": "bgLighter" },
    "borderSubtle": { "dark": "bgLighter", "light": "muted" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "muted", "light": "muted" },
    "diffHighlightAdded": { "dark": "greenBright", "light": "greenBright" },
    "diffHighlightRemoved": { "dark": "redBright", "light": "redBright" },
    "diffAddedBg": { "dark": "bgLighter", "light": "fgLight" },
    "diffRemovedBg": { "dark": "bgLighter", "light": "fgLight" },
    "diffContextBg": { "dark": "bgDarker", "light": "fgLight" },
    "diffLineNumber": { "dark": "muted", "light": "fg" },
    "diffAddedLineNumberBg": { "dark": "bgLighter", "light": "fgLight" },
    "diffRemovedLineNumberBg": { "dark": "bgLighter", "light": "fgLight" },
    "markdownText": { "dark": "fg", "light": "bg" },
    "markdownHeading": { "dark": "pale", "light": "olive" },
    "markdownLink": { "dark": "olive", "light": "olive" },
    "markdownLinkText": { "dark": "paleBright", "light": "paleBright" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "orange", "light": "orange" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "muted", "light": "muted" },
    "markdownListItem": { "dark": "pale", "light": "olive" },
    "markdownListEnumeration": { "dark": "paleBright", "light": "paleBright" },
    "markdownImage": { "dark": "olive", "light": "olive" },
    "markdownImageText": { "dark": "paleBright", "light": "paleBright" },
    "markdownCodeBlock": { "dark": "fg", "light": "bg" },
    "syntaxComment": { "dark": "muted", "light": "bgLighter" },
    "syntaxKeyword": { "dark": "olive", "light": "olive" },
    "syntaxFunction": { "dark": "pale", "light": "pale" },
    "syntaxVariable": { "dark": "paleBright", "light": "paleBright" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "tan", "light": "tan" },
    "syntaxType": { "dark": "oliveBright", "light": "oliveBright" },
    "syntaxOperator": { "dark": "olive", "light": "olive" },
    "syntaxPunctuation": { "dark": "fg", "light": "bg" }
  }
}
