{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#060114",
    "bgPanel": "#0d0820",
    "bgElement": "#1f1a2c",
    "bgDark": "#03010a",
    "fg": "#D7DBE9",
    "fgMuted": "#66656b",
    "fgDark": "#a1a4af",
    "accent": "#757b9d",
    "ice": "#a1c4e4",
    "cyan": "#bad8ff",
    "violet": "#aaa2ce",
    "violetBright": "#c1b6ee",
    "blueBright": "#aedcff",
    "cyanBright": "#caf0ff",
    "iceBright": "#bcfbff",
    "mauve": "#9c8ba9",
    "mauveBright": "#b39fc5"
  },
  "theme": {
    "primary": { "dark": "accent", "light": "accent" },
    "secondary": { "dark": "ice", "light": "ice" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "mauve", "light": "mauve" },
    "warning": { "dark": "cyanBright", "light": "cyanBright" },
    "success": { "dark": "ice", "light": "ice" },
    "info": { "dark": "cyan", "light": "cyan" },
    "text": { "dark": "fg", "light": "bg" },
    "textMuted": { "dark": "fgMuted", "light": "bgElement" },
    "background": { "dark": "bg", "light": "fg" },
    "backgroundPanel": { "dark": "bgPanel", "light": "fg" },
    "backgroundElement": { "dark": "bgElement", "light": "fg" },
    "border": { "dark": "bgElement", "light": "fgMuted" },
    "borderActive": { "dark": "accent", "light": "accent" },
    "borderSubtle": { "dark": "bgElement", "light": "fgMuted" },
    "diffAdded": { "dark": "ice", "light": "ice" },
    "diffRemoved": { "dark": "mauve", "light": "mauve" },
    "diffContext": { "dark": "fgMuted", "light": "fgMuted" },
    "diffHunkHeader": { "dark": "fgMuted", "light": "fgMuted" },
    "diffHighlightAdded": { "dark": "iceBright", "light": "iceBright" },
    "diffHighlightRemoved": { "dark": "mauveBright", "light": "mauveBright" },
    "diffAddedBg": { "dark": "bgElement", "light": "fg" },
    "diffRemovedBg": { "dark": "bgPanel", "light": "fg" },
    "diffContextBg": { "dark": "bgDark", "light": "fg" },
    "diffLineNumber": { "dark": "fgMuted", "light": "fgDark" },
    "diffAddedLineNumberBg": { "dark": "bgElement", "light": "fg" },
    "diffRemovedLineNumberBg": { "dark": "bgElement", "light": "fg" },
    "markdownText": { "dark": "fg", "light": "bg" },
    "markdownHeading": { "dark": "cyan", "light": "accent" },
    "markdownLink": { "dark": "ice", "light": "accent" },
    "markdownLinkText": { "dark": "blueBright", "light": "accent" },
    "markdownCode": { "dark": "ice", "light": "ice" },
    "markdownBlockQuote": { "dark": "fgMuted", "light": "fgMuted" },
    "markdownEmph": { "dark": "violet", "light": "violet" },
    "markdownStrong": { "dark": "cyanBright", "light": "cyanBright" },
    "markdownHorizontalRule": { "dark": "fgMuted", "light": "fgMuted" },
    "markdownListItem": { "dark": "accent", "light": "accent" },
    "markdownListEnumeration": { "dark": "blueBright", "light": "blueBright" },
    "markdownImage": { "dark": "ice", "light": "ice" },
    "markdownImageText": { "dark": "blueBright", "light": "blueBright" },
    "markdownCodeBlock": { "dark": "fg", "light": "bg" },
    "syntaxComment": { "dark": "fgMuted", "light": "fgMuted" },
    "syntaxKeyword": { "dark": "accent", "light": "accent" },
    "syntaxFunction": { "dark": "cyan", "light": "cyan" },
    "syntaxVariable": { "dark": "blueBright", "light": "blueBright" },
    "syntaxString": { "dark": "ice", "light": "ice" },
    "syntaxNumber": { "dark": "violet", "light": "violet" },
    "syntaxType": { "dark": "cyanBright", "light": "cyanBright" },
    "syntaxOperator": { "dark": "accent", "light": "accent" },
    "syntaxPunctuation": { "dark": "fg", "light": "bg" }
  }
}
