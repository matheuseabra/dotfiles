// Stills in Motion (mattbbia/stills-in-motion)
// Alternative fastfetch palette. Run with: fastfetch --config stills-in-motion.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": { "top": 3 }
    },
    "display": {
        "color": {
            "title": "#dfddb2",
            "keys": "#7e8468"
        },
        "percent": {
            "type": 9,
            "color": {
                "green": "#cbc3a3",
                "yellow": "#fef2cb",
                "red": "#a2947d"
            }
        }
    },
    "modules": [
        "title", "separator", "os", "host", "packages", "shell", "wm",
        "wmtheme", "theme", "font", "terminal", "cpu", "gpu", "memory", "disk"
    ]
}
