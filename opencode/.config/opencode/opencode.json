{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "XcodeBuildMCP": {
      "type": "local",
      "command": [
        "xcodebuildmcp",
        "mcp"
      ]
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer fc-0b69f533a3ab4d30878c3c7b46446e2b"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "aseprite": {
      "type": "local",
      "command": [
        "/Users/matheusseabra/.local/bin/uv",
        "--directory",
        "/Users/matheusseabra/.local/share/aseprite-mcp",
        "run",
        "-m",
        "aseprite_mcp"
      ],
      "enabled": true,
      "env": {
        "ASEPRITE_PATH": "/Applications/Aseprite.app/Contents/MacOS/aseprite"
      }
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    }
  },
  "plugin": [],
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra"
    },
    "build": {
      "model": "openai/gpt-5.6-terra"
    }
  },
  "formatter": true,
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "allow",
      "npm *": "allow",
      "rm *": "deny",
      "grep *": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "external_directory": {
      "~/.config/**": "allow",
      "~/Desktop/www/**": "allow"
    }
  }
}
