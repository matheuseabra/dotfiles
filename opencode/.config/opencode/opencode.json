{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      "xcodebuild": {
        "type": "local",
        "command": ["npx", "-y", "xcodebuildmcp@latest", "mcp"]
      },
      "grep_app": {
        "type": "local",
        "command": [
          "node",
          "/Users/matheusseabra/.local/share/mcp/grep_app_mcp/dist/server-stdio.js"
        ]
      },
      "firecrawl": {
        "type": "local",
        "command": ["npx", "-y", "firecrawl-mcp"],
        "environment": {
          "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
        }
      }
    }
  }
}
