{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#2e3440",
    "bgLighter": "#3b4252",
    "bgSelected": "#434c5e",
    "bgMuted": "#4c566a",
    "bgDark": "#222730",
    "bgDarker": "#191c23",
    "fg": "#d8dee9",
    "fgLight": "#adb5c4",
    "fgDark": "#667080",
    "frostBright": "#8fbcbb",
    "frostCyan": "#88c0d0",
    "frostBlue": "#81a1c1",
    "red": "#bf616a",
    "orange": "#d5967a",
    "yellow": "#ebcb8b",
    "green": "#a3be8c",
    "magenta": "#b48ead"
  },
  "theme": {
    "primary": { "dark": "frostCyan", "light": "frostBlue" },
    "secondary": { "dark": "frostBlue", "light": "frostBlue" },
    "accent": { "dark": "frostBright", "light": "frostBright" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "frostCyan", "light": "frostBlue" },
    "text": { "dark": "fg", "light": "bg" },
    "textMuted": { "dark": "fgDark", "light": "bgMuted" },
    "background": { "dark": "bg", "light": "fgLight" },
    "backgroundPanel": { "dark": "bgLighter", "light": "fgLight" },
    "backgroundElement": { "dark": "bgLighter", "light": "fgLight" },
    "border": { "dark": "bgSelected", "light": "bgMuted" },
    "borderActive": { "dark": "bgMuted", "light": "bgSelected" },
    "borderSubtle": { "dark": "bgSelected", "light": "bgMuted" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "bgMuted", "light": "bgMuted" },
    "diffHunkHeader": { "dark": "bgMuted", "light": "bgMuted" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "bgLighter", "light": "fgLight" },
    "diffRemovedBg": { "dark": "bgLighter", "light": "fgLight" },
    "diffContextBg": { "dark": "bgDarker", "light": "fgLight" },
    "diffLineNumber": { "dark": "bgMuted", "light": "fg" },
    "diffAddedLineNumberBg": { "dark": "bgLighter", "light": "fgLight" },
    "diffRemovedLineNumberBg": { "dark": "bgLighter", "light": "fgLight" },
    "markdownText": { "dark": "fg", "light": "bg" },
    "markdownHeading": { "dark": "frostCyan", "light": "frostBlue" },
    "markdownLink": { "dark": "frostBlue", "light": "frostBlue" },
    "markdownLinkText": { "dark": "frostBright", "light": "frostBright" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "bgMuted", "light": "bgMuted" },
    "markdownEmph": { "dark": "orange", "light": "orange" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "bgMuted", "light": "bgMuted" },
    "markdownListItem": { "dark": "frostCyan", "light": "frostBlue" },
    "markdownListEnumeration": { "dark": "frostBright", "light": "frostBright" },
    "markdownImage": { "dark": "frostBlue", "light": "frostBlue" },
    "markdownImageText": { "dark": "frostBright", "light": "frostBright" },
    "markdownCodeBlock": { "dark": "fg", "light": "bg" },
    "syntaxComment": { "dark": "fgDark", "light": "bgMuted" },
    "syntaxKeyword": { "dark": "frostBlue", "light": "frostBlue" },
    "syntaxFunction": { "dark": "frostCyan", "light": "frostCyan" },
    "syntaxVariable": { "dark": "frostBright", "light": "frostBright" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "magenta", "light": "magenta" },
    "syntaxType": { "dark": "frostBright", "light": "frostBright" },
    "syntaxOperator": { "dark": "frostBlue", "light": "frostBlue" },
    "syntaxPunctuation": { "dark": "fg", "light": "bg" }
  }
}
