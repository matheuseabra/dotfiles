{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "spaceBg": "#060114",
    "spacePanel": "#0d0820",
    "spaceElement": "#1f1a2c",
    "spaceBorder": "#38324f",
    "spaceFg": "#D7DBE9",
    "spaceFgBright": "#f3f4ff",
    "spaceFgMuted": "#66656b",
    "spaceFgDark": "#a1a4af",
    "spaceBlue": "#757b9d",
    "spaceIce": "#a1c4e4",
    "spaceCyan": "#bad8ff",
    "spaceCyanBright": "#caf0ff",
    "spaceViolet": "#aaa2ce",
    "spaceVioletBright": "#c1b6ee",
    "spaceMauve": "#9c8ba9",
    "spaceMauveBright": "#b39fc5",
    "spaceYellow": "#c4f6ff",
    "spaceOrange": "#ab9cb6",
    "lightBg": "#f3f4ff",
    "lightPanel": "#e6e9f4",
    "lightElement": "#d7dbea",
    "lightBorder": "#b3b6c3",
    "lightText": "#1f1a2c",
    "lightMuted": "#675e6d",
    "lightBlue": "#4b557d",
    "lightIce": "#466d7e",
    "lightCyan": "#3e6685",
    "lightViolet": "#6f6695",
    "lightMauve": "#705a78",
    "lightYellow": "#55727e",
    "lightOrange": "#675b73"
  },
  "theme": {
    "primary": { "dark": "spaceBlue", "light": "lightBlue" },
    "secondary": { "dark": "spaceViolet", "light": "lightViolet" },
    "accent": { "dark": "spaceCyan", "light": "lightCyan" },
    "error": { "dark": "spaceMauveBright", "light": "lightMauve" },
    "warning": { "dark": "spaceYellow", "light": "lightYellow" },
    "success": { "dark": "spaceIce", "light": "lightIce" },
    "info": { "dark": "spaceCyan", "light": "lightCyan" },
    "text": { "dark": "spaceFg", "light": "lightText" },
    "textMuted": { "dark": "spaceFgMuted", "light": "lightMuted" },
    "background": { "dark": "spaceBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "spacePanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "spaceElement", "light": "lightElement" },
    "border": { "dark": "spaceBorder", "light": "lightBorder" },
    "borderActive": { "dark": "spaceCyan", "light": "lightCyan" },
    "borderSubtle": { "dark": "spaceElement", "light": "lightElement" },
    "diffAdded": { "dark": "spaceIce", "light": "lightIce" },
    "diffRemoved": { "dark": "spaceMauve", "light": "lightMauve" },
    "diffContext": { "dark": "spaceFgMuted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "spaceViolet", "light": "lightViolet" },
    "diffHighlightAdded": { "dark": "spaceCyan", "light": "lightCyan" },
    "diffHighlightRemoved": { "dark": "spaceMauveBright", "light": "lightMauve" },
    "diffAddedBg": { "dark": "spacePanel", "light": "lightPanel" },
    "diffRemovedBg": { "dark": "spaceElement", "light": "lightElement" },
    "diffContextBg": { "dark": "spacePanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "spaceFgMuted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "spacePanel", "light": "lightPanel" },
    "diffRemovedLineNumberBg": { "dark": "spaceElement", "light": "lightElement" },
    "markdownText": { "dark": "spaceFg", "light": "lightText" },
    "markdownHeading": { "dark": "spaceCyan", "light": "lightCyan" },
    "markdownLink": { "dark": "spaceCyanBright", "light": "lightCyan" },
    "markdownLinkText": { "dark": "spaceCyan", "light": "lightCyan" },
    "markdownCode": { "dark": "spaceIce", "light": "lightIce" },
    "markdownBlockQuote": { "dark": "spaceFgMuted", "light": "lightMuted" },
    "markdownEmph": { "dark": "spaceYellow", "light": "lightYellow" },
    "markdownStrong": { "dark": "spaceFgBright", "light": "lightText" },
    "markdownHorizontalRule": { "dark": "spaceBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "spaceViolet", "light": "lightViolet" },
    "markdownListEnumeration": { "dark": "spaceBlue", "light": "lightBlue" },
    "markdownImage": { "dark": "spaceCyan", "light": "lightCyan" },
    "markdownImageText": { "dark": "spaceCyanBright", "light": "lightCyan" },
    "markdownCodeBlock": { "dark": "spaceFg", "light": "lightText" },
    "syntaxComment": { "dark": "spaceFgMuted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "spaceViolet", "light": "lightViolet" },
    "syntaxFunction": { "dark": "spaceBlue", "light": "lightBlue" },
    "syntaxVariable": { "dark": "spaceFgBright", "light": "lightText" },
    "syntaxString": { "dark": "spaceIce", "light": "lightIce" },
    "syntaxNumber": { "dark": "spaceOrange", "light": "lightOrange" },
    "syntaxType": { "dark": "spaceYellow", "light": "lightYellow" },
    "syntaxOperator": { "dark": "spaceVioletBright", "light": "lightViolet" },
    "syntaxPunctuation": { "dark": "spaceFgDark", "light": "lightMuted" }
  }
}
