{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#f5f2e9",
    "bgPanel": "#f6f3eb",
    "fg": "#492924",
    "gray": "#85837d",
    "olive": "#72684b",
    "oliveDeep": "#726947",
    "sage": "#796e51",
    "khaki": "#706548",
    "moss": "#6f6644",
    "umber": "#6e4740",
    "tan": "#9e926c",
    "gold": "#968c65"
  },
  "theme": {
    "primary": { "dark": "olive", "light": "olive" },
    "secondary": { "dark": "sage", "light": "sage" },
    "accent": { "dark": "oliveDeep", "light": "oliveDeep" },
    "error": { "dark": "umber", "light": "umber" },
    "warning": { "dark": "khaki", "light": "khaki" },
    "success": { "dark": "moss", "light": "moss" },
    "info": { "dark": "olive", "light": "olive" },
    "text": { "dark": "bg", "light": "fg" },
    "textMuted": { "dark": "tan", "light": "gray" },
    "background": { "dark": "fg", "light": "bg" },
    "backgroundPanel": { "dark": "umber", "light": "bgPanel" },
    "backgroundElement": { "dark": "umber", "light": "bgPanel" },
    "border": { "dark": "umber", "light": "gray" },
    "borderActive": { "dark": "khaki", "light": "khaki" },
    "borderSubtle": { "dark": "umber", "light": "gray" },
    "diffAdded": { "dark": "moss", "light": "moss" },
    "diffRemoved": { "dark": "khaki", "light": "khaki" },
    "diffContext": { "dark": "tan", "light": "gray" },
    "diffHunkHeader": { "dark": "tan", "light": "gray" },
    "diffHighlightAdded": { "dark": "moss", "light": "moss" },
    "diffHighlightRemoved": { "dark": "umber", "light": "umber" },
    "diffAddedBg": { "dark": "umber", "light": "bgPanel" },
    "diffRemovedBg": { "dark": "umber", "light": "bgPanel" },
    "diffContextBg": { "dark": "umber", "light": "bgPanel" },
    "diffLineNumber": { "dark": "tan", "light": "gray" },
    "diffAddedLineNumberBg": { "dark": "umber", "light": "bgPanel" },
    "diffRemovedLineNumberBg": { "dark": "umber", "light": "bgPanel" },
    "markdownText": { "dark": "bg", "light": "fg" },
    "markdownHeading": { "dark": "olive", "light": "olive" },
    "markdownLink": { "dark": "sage", "light": "sage" },
    "markdownLinkText": { "dark": "gold", "light": "gold" },
    "markdownCode": { "dark": "moss", "light": "moss" },
    "markdownBlockQuote": { "dark": "tan", "light": "gray" },
    "markdownEmph": { "dark": "khaki", "light": "khaki" },
    "markdownStrong": { "dark": "oliveDeep", "light": "oliveDeep" },
    "markdownHorizontalRule": { "dark": "tan", "light": "gray" },
    "markdownListItem": { "dark": "olive", "light": "olive" },
    "markdownListEnumeration": { "dark": "gold", "light": "gold" },
    "markdownImage": { "dark": "sage", "light": "sage" },
    "markdownImageText": { "dark": "gold", "light": "gold" },
    "markdownCodeBlock": { "dark": "bg", "light": "fg" },
    "syntaxComment": { "dark": "tan", "light": "gray" },
    "syntaxKeyword": { "dark": "olive", "light": "olive" },
    "syntaxFunction": { "dark": "oliveDeep", "light": "oliveDeep" },
    "syntaxVariable": { "dark": "bg", "light": "fg" },
    "syntaxString": { "dark": "moss", "light": "moss" },
    "syntaxNumber": { "dark": "sage", "light": "sage" },
    "syntaxType": { "dark": "khaki", "light": "khaki" },
    "syntaxOperator": { "dark": "olive", "light": "olive" },
    "syntaxPunctuation": { "dark": "bg", "light": "fg" }
  }
}
