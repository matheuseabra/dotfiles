# macOS metadata
.DS_Store
**/.DS_Store
logs/

# Secrets and local environment overrides
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Generated application state and local tooling
.pi/
**/node_modules/
**/automatic_backups/
**/*.log
zsh/.zshrc.bak.*
herdr/.config/herdr/plugins/
herdr/.config/herdr/plugins.json
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/session.json
herdr/.config/herdr/*.sock

# opencode integration files installed and overwritten by tools
opencode/.config/opencode/hooks/
opencode/.config/opencode/plugins/
opencode/.config/opencode/herdr-tui-session.js
opencode/.config/opencode/bun.lock
.commandcode
