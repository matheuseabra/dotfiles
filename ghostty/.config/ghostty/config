keybind = alt+shift+v=text:\x16
keybind = alt+shift+h=text:\x08
keybind = ctrl+enter=csi:13;5u
keybind = alt+arrow_left=text:\x1b[1;3D
keybind = alt+arrow_right=text:\x1b[1;3C
keybind = alt+arrow_up=text:\x1b[1;3A
keybind = alt+arrow_down=text:\x1b[1;3B

command = tmux
shell-integration = detect

theme = TokyoNight Night

font-family = "FiraCode Nerd Font"
font-style = SemiBold
font-thicken = false
font-thicken-strength = 255
font-size = 18.5

background-opacity = 0.7
background-blur = false
background-blur-radius = 0

window-theme = auto
window-decoration = true
window-padding-x = 0
window-padding-y = 0
window-inherit-working-directory = false

macos-titlebar-style = hidden
macos-icon = glass
macos-icon-frame = chrome
macos-icon-ghost-color = #ffffff
macos-icon-screen-color = #0800ff
macos-option-as-alt = true
macos-window-buttons = visible

mouse-hide-while-typing = true
unfocused-split-opacity = 1

cursor-style-blink = false
cursor-style = bar

split-inherit-working-directory = true
