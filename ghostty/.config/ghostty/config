keybind = ctrl+enter=csi:13;5u
keybind = alt+arrow_left=text:\x1b[1;3D
keybind = alt+arrow_right=text:\x1b[1;3C
keybind = alt+arrow_up=text:\x1b[1;3A
keybind = alt+arrow_down=text:\x1b[1;3B

shell-integration = detect
command = /Users/matheusseabra/.local/bin/herdr

# SpaceX Terrafab palette. Keep these explicit so Herdr's `terminal` theme
# and terminal applications all inherit the same ANSI colors.
background = #060114
foreground = #D7DBE9
selection-background = #D7DBE9
selection-foreground = #060114
palette = 0=#060114
palette = 1=#9c8ba9
palette = 2=#a1c4e4
palette = 3=#c4f6ff
palette = 4=#757b9d
palette = 5=#aaa2ce
palette = 6=#bad8ff
palette = 7=#D7DBE9
palette = 8=#66656b
palette = 9=#b39fc5
palette = 10=#aedcff
palette = 11=#bcfbff
palette = 12=#898fb9
palette = 13=#c1b6ee
palette = 14=#caf0ff
palette = 15=#f3f4ff

font-family = "JetBrainsMono Nerd Font"
font-style = Bold
font-thicken = false
font-thicken-strength = 255
font-size = 18.5

background-opacity = 0.5
background-blur = false
background-blur-radius = 20

window-theme = auto
window-decoration = true
window-padding-x = 0
window-padding-y = 0
window-inherit-working-directory = false

macos-titlebar-style = hidden
macos-icon = glass
macos-option-as-alt = true
macos-window-buttons = visible

mouse-hide-while-typing = true
unfocused-split-opacity = 1

cursor-style-blink = false
cursor-style = bar

split-inherit-working-directory = true
