keybind = ctrl+enter=csi:13;5u
keybind = alt+arrow_left=text:\x1b[1;3D
keybind = alt+arrow_right=text:\x1b[1;3C
keybind = alt+arrow_up=text:\x1b[1;3A
keybind = alt+arrow_down=text:\x1b[1;3B

shell-integration = detect
command = /Users/matheusseabra/.local/bin/herdr

# SpaceX Terrafab palette (themes/spacex-terrafab). Keep colors in the theme
# file so Herdr's `terminal` theme and terminal applications inherit the same
# ANSI colors. Override with `ghostty +list-themes` if you want to switch.
theme = spacex-terrafab

font-family = "FiraCode Nerd Font"
font-style = Semibold
font-thicken = true
font-thicken-strength = 55
font-size = 17.5

background-opacity = 0.5
background-blur = true
background-blur-radius = 10

window-theme = auto
window-decoration = true
window-padding-x = 0
window-padding-y = 0
window-inherit-working-directory = false

macos-titlebar-style = hidden
macos-icon = glass
macos-option-as-alt = true
macos-window-buttons = visible

mouse-hide-while-typing = true
unfocused-split-opacity = 1

cursor-style-blink = false
cursor-style = bar

split-inherit-working-directory = true
