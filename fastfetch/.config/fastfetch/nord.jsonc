// Nord (Omarchy) — https://github.com/basecamp/omarchy/tree/master/themes/nord
// Alternative fastfetch palette. Run with: fastfetch --config nord
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": { "top": 3 }
    },
    "display": {
        "color": {
            "title": "#88c0d0",
            "keys": "#81a1c1"
        },
        "percent": {
            "type": 9,
            "color": {
                "green": "#a3be8c",
                "yellow": "#ebcb8b",
                "red": "#bf616a"
            }
        }
    },
    "modules": [
        "title", "separator", "os", "host", "packages", "shell", "wm",
        "wmtheme", "theme", "font", "terminal", "cpu", "gpu", "memory", "disk"
    ]
}
