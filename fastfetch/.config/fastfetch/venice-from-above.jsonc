// Venice From Above (mattbbia/venice-from-above)
// Alternative fastfetch palette. Run with: fastfetch --config venice-from-above.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": { "top": 3 }
    },
    "display": {
        "color": {
            "title": "#492924",
            "keys": "#72684b"
        },
        "percent": {
            "type": 9,
            "color": {
                "green": "#6f6644",
                "yellow": "#6f6645",
                "red": "#706548"
            }
        }
    },
    "modules": [
        "title", "separator", "os", "host", "packages", "shell", "wm",
        "wmtheme", "theme", "font", "terminal", "cpu", "gpu", "memory", "disk"
    ]
}
