{
  "id": "spacex-terrafab",
  "name": "SpaceX Terrafab",
  "version": "1.0.0",
  "description": "Near-black violet editor theme with ice blue, cyan, lilac, and mauve accents.",
  "themes": [
    {
      "id": "spacex-terrafab",
      "name": "SpaceX Terrafab",
      "ui": {
        "bg": "#060114",
        "panelBg": "#0d0820",
        "barBg": "#03010a",
        "statusBg": "#757b9d",
        "statusFg": "#060114",
        "text": "#D7DBE9",
        "dim": "#a1a4af",
        "faint": "#66656b",
        "accent": "#757b9d",
        "activeTabFg": "#f3f4ff",
        "inactiveTabFg": "#66656b",
        "treeSelectedBg": "#1f1a2c",
        "treeFocusBg": "#2a243c",
        "dirty": "#c4f6ff",
        "error": "#b39fc5",
        "folder": "#bad8ff",
        "cursor": "#D7DBE9",
        "scrollbar": "#757b9d",
        "gutter": "#66656b",
        "currentLine": "#1f1a2c",
        "indentGuide": "#2a243c",
        "gitAdded": "#a1c4e4",
        "gitModified": "#c4f6ff",
        "gitDeleted": "#9c8ba9"
      },
      "syntax": {
        "comment": { "fg": "#66656b", "italic": true },
        "keyword": { "fg": "#aaa2ce" },
        "string": { "fg": "#a1c4e4" },
        "number": { "fg": "#ab9cb6" },
        "boolean": { "fg": "#ab9cb6" },
        "constant": { "fg": "#ab9cb6" },
        "function": { "fg": "#757b9d" },
        "type": { "fg": "#c4f6ff" },
        "variable": { "fg": "#D7DBE9" },
        "property": { "fg": "#bad8ff" },
        "tag": { "fg": "#9c8ba9" },
        "operator": { "fg": "#aaa2ce" },
        "punctuation": { "fg": "#a1a4af" },
        "label": { "fg": "#ab9cb6" },
        "escape": { "fg": "#c4f6ff" },
        "embedded": { "fg": "#D7DBE9" },
        "error": { "fg": "#b39fc5" },
        "markup.heading": { "fg": "#bad8ff", "bold": true },
        "markup.strong": { "fg": "#D7DBE9", "bold": true },
        "markup.italic": { "fg": "#D7DBE9", "italic": true },
        "markup.raw": { "fg": "#a1c4e4" },
        "markup.link": { "fg": "#bad8ff" },
        "markup.link.url": { "fg": "#caf0ff", "underline": true },
        "markup.list": { "fg": "#aaa2ce" },
        "markup.quote": { "fg": "#66656b", "italic": true }
      }
    }
  ]
}
